{
  "name": "marked-inline-spoilers",
  "version": "1.0.1",
  "description": "Inline spoilers for markedjs",
  "main": "./lib/index.cjs",
  "module": "./src/index.js",
  "browser": "./lib/index.umd.js",
  "types": "./lib/index.d.cts",
  "type": "module",
  "files": [
    "lib/",
    "src/"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "keywords": [
    "marked",
    "extension",
    "inline",
    "spoilers"
  ],
  "scripts": {
    "test": "jest --verbose",
    "test:cover": "jest --coverage",
    "test:types": "npm run build && tsd -t src/index.d.ts -f spec/index.test-d.ts && attw -P",
    "test:all": "npm run test:cover && npm run test:types && npm run lint",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "build": "rollup -c rollup.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stakkd-tv/marked-inline-spoilers.git"
  },
  "author": "Tanveer Najib <tanveer@stellarworks.dev> (https://crxssed.dev)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stakkd-tv/marked-inline-spoilers/issues"
  },
  "homepage": "https://github.com/stakkd-tv/marked-inline-spoilers#readme",
  "peerDependencies": {
    "marked": ">=1 <19"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@markedjs/eslint-config": "^1.0.14",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "babel-jest": "^30.3.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest-cli": "^30.4.2",
    "marked": "^18.0.10",
    "rollup": "^4.62.4",
    "rollup-plugin-copy": "^3.5.0",
    "semantic-release": "^25.0.9",
    "tsd": "^0.33.0"
  },
  "tsd": {
    "compilerOptions": {
      "paths": {
        "marked-inline-spoilers": [
          "./src"
        ]
      }
    }
  }
}
